{
  "name": "train-to-trail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Trains, buses, trails and terrain on one map to plan your hikes",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx && node scripts/check-contrast.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,tsx,json,md,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,tsx,json,md,html}\"",
    "build:thumbs": "node scripts/build-basemap-thumbs.mjs",
    "build:transit": "node scripts/transit/build.mjs",
    "build:transit:all": "node scripts/transit/build.mjs all",
    "gr:fetch": "node scripts/gr/fetch-overpass.mjs",
    "gr:colours": "node scripts/gr/assign-colours.mjs",
    "gr:tiles": "bash scripts/gr/build-tiles.sh",
    "build:gr": "npm run gr:fetch && npm run gr:colours && npm run gr:tiles",
    "build:search": "node scripts/search/build-index.mjs",
    "build:rail": "bash scripts/build-rail-tiles.sh && bash scripts/build-rail-stations.sh",
    "build:data": "npm run build:rail && npm run build:transit:all && npm run build:gr && npm run build:search",
    "data:download": "bash scripts/download-data.sh",
    "bench:elevation": "node scripts/benchmark-elevation.mjs",
    "media": "bash scripts/media/build.sh"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "idb": "^8.0.3",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.10",
    "csv-parse": "^6.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "prettier": "^3.3.3",
    "puppeteer-core": "25.0.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlossantosgarcia/train-to-trail.git"
  }
}
